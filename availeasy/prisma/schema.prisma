// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum AvailabilityState {
  available
  unavailable
  busy
  tentative
}

enum CurrentStatusState {
  available
  busy
  away
  offline
  custom
}

enum ExceptionSource {
  manual
  api
  calendar
  system
}

model User {
  id                 String                @id @default(uuid())
  email              String                @unique
  name               String?
  handle             String                @unique
  timezone           String                @default("UTC")
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  AvailabilityRule   AvailabilityRule[]
  AvailabilityException AvailabilityException[]
  CurrentStatus      CurrentStatus?
  ApiToken           ApiToken[]
  WebhookSubscription WebhookSubscription[]
  accounts           Account[]
  sessions           Session[]
}

model AvailabilityRule {
  id             String          @id @default(uuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayOfWeek      Int // 0-6 where 0 = Sunday
  startTimeLocal String // format "HH:mm"
  endTimeLocal   String // format "HH:mm"
  timezone       String // IANA timezone
  state          AvailabilityState
  priority       Int             @default(0)
  validFrom      DateTime?
  validUntil     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([userId, dayOfWeek, startTimeLocal, endTimeLocal, timezone, state, priority])
}

model AvailabilityException {
  id          String            @id @default(uuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  startsAt    DateTime // stored UTC
  endsAt      DateTime // stored UTC
  state       AvailabilityState
  publicLabel String?
  privateNote String?
  source      ExceptionSource
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model CurrentStatus {
  id        String           @id @default(uuid())
  userId    String           @unique
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  state     CurrentStatusState
  message   String?
  validUntil DateTime?
  updatedAt DateTime         @updatedAt
}

model ApiToken {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  tokenHash   String
  tokenPrefix String
  scopes      Json // or String[] in Postgres, but using Json for cross-DB compatibility
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?
  lastUsedAt  DateTime?
}

model WebhookSubscription {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  url       String
  events    Json // or String[] in Postgres, but using Json for cross-DB compatibility
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// NextAuth.js models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
